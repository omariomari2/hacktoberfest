# Copy to .env (git-ignored) or set in the deployment's environment.
# Never commit real values.
GEMINI_API_KEY=
CLICKY_APP_TOKEN=
PORT=8787
# prepend (default, works for all Gemma models) or instruction
GEMMA_SYSTEM_PROMPT_MODE=prepend
# Optional speech routes; missing values return 503 not_configured
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ASSEMBLYAI_API_KEY=
